{
  "name": "treeloom",
  "author": "Joshua Heagle <joshuaheagle@gmail.com> (https://joshuaheagle.com)",
  "license": "MPL-2.0",
  "description": "State management with JSON.",
  "homepage": "https://github.com/jheagle/treeloom#readme",
  "keywords": [
    "json",
    "tree",
    "virtual dom",
    "dom",
    "state management",
    "serialization",
    "typescript"
  ],
  "version": "2.1.0",
  "bugs": {
    "url": "https://github.com/jheagle/treeloom/issues"
  },
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "lint": "gulp lint",
    "prepublishOnly": "npm run build",
    "publish:bundle": "gulp copyFiles",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "resolutions": "npx npm-force-resolutions",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.type-tests.json",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest"
  },
  "dependencies": {
    "collect-your-stuff": "^2.2.1",
    "core-js": "^3.51.0",
    "si-funciona": "^2.10.0"
  },
  "devDependencies": {
    "@babel/core": "^8.1.0",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/preset-env": "^8.0.7",
    "gulp": "^5.0.1",
    "js-build-tools": "^8.2.0",
    "release-it": "^21.1.2",
    "standard": "^17.1.2",
    "test-filesystem": "^2.0.0",
    "typedoc": "^0.28.20"
  },
  "resolutions": {},
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jheagle/treeloom.git"
  },
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "browser"
  ],
  "standard": {
    "env": [
      "jest",
      "browser"
    ]
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "esbuild": false
  }
}
