{
  "name": "json-dom",
  "private": true,
  "author": "Joshua Heagle <joshuaheagle@gmail.com> (https://joshuaheagle.com)",
  "description": "State management with JSON.",
  "homepage": "https://github.com/jheagle/json-dom#readme",
  "keywords": [
    "dom",
    "json",
    "state management"
  ],
  "version": "1.8.1",
  "bugs": {
    "url": "https://github.com/jheagle/json-dom/issues"
  },
  "scripts": {
    "build": "gulp build",
    "dev": "gulp",
    "docs": "gulp docs",
    "publish:bundle": "gulp copyFiles",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "resolutions": "npx npm-force-resolutions",
    "test": "gulp testFull",
    "test:quick": "gulp testQuick",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.type-tests.json",
    "watch": "gulp watchFull",
    "watch:test": "gulp watchTest",
    "lint": "gulp lint"
  },
  "dependencies": {
    "collect-your-stuff": "^2.2.1",
    "si-funciona": "^2.7.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "gulp": "^5.0.1",
    "js-build-tools": "^6.9.0",
    "release-it": "^21.1.1",
    "standard": "^17.1.2",
    "test-filesystem": "^2.0.0",
    "typedoc": "^0.28.20"
  },
  "resolutions": {},
  "repository": "github:jheagle/json-dom",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "files": [
    "dist",
    "browser"
  ],
  "standard": {
    "env": [
      "jest",
      "browser"
    ]
  },
  "allowScripts": {
    "core-js": false,
    "core-js-pure": false,
    "@parcel/watcher": false,
    "unrs-resolver": false,
    "esbuild": false
  }
}
