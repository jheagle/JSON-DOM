{
  "browser": {
    "name": "jsonDom",
    "bundles": [
      {
        "name": "jsonDomRenderOnly",
        "main": "dist/renderOnly"
      }
    ]
  },
  "copyFiles": [
    {
      "from": "browser/*.js",
      "to": "../joshuaheagle.local/projects/json-dom/browser"
    }
  ],
  "docs": {
    "enabled": true,
    "from": "src",
    "index": "MAIN.md",
    "to": "../joshuaheagle.local/projects/json-dom/docs",
    "inBuild": false,
    "gitRevision": "main"
  },
  "typescript": {
    "config": "tsconfig.json",
    "enabled": true
  }
}
